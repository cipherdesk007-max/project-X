# Alvea: impostazioni. Copiato in .env da "python3 manage.py init".

# 1 = modello finto a regole fisse, per provare senza chiavi. 0 = modelli veri.
SFB_DEMO=1
# Solo in demo: millisecondi di attesa finta di modello e strumenti, per vedere gli stati nell'Ufficio 3D. 0 = nessuna.
SFB_DEMO_DELAY_MS=900

# Chiavi dei modelli (della piattaforma). Un'azienda può mettere le proprie nei Collegamenti.
ANTHROPIC_API_KEY=
MOONSHOT_API_KEY=
OPENAI_API_KEY=

# Nomi dei modelli. Controllali sui siti dei fornitori: i nomi cambiano spesso.
CLAUDE_MODEL=claude-sonnet-5-5
KIMI_MODEL=kimi-k3
OPENAI_MODEL=

# Indirizzi delle API (di norma non si toccano)
KIMI_BASE_URL=https://api.moonshot.ai/v1

# Ricerca web per tutte le aziende (facoltativa): chiave Brave Search API
BRAVE_API_KEY=

# Chiave per cifrare le credenziali dei collegamenti. La genera "manage.py init".
# Se la cambi, le credenziali già salvate non si leggono più.
SFB_SECRET_KEY=

# Dove ascolta il server. Lascia 127.0.0.1 finché non c'è un proxy HTTPS davanti.
SFB_HOST=127.0.0.1
SFB_PORT=8787

# Indirizzo con cui si apre Alvea nel browser. Serve all'accesso Google; con HTTPS mettere quello pubblico.
SFB_PUBLIC_URL=http://127.0.0.1:8787

# Accesso Google (Gmail, Calendar, Fogli): client OAuth di tipo "Applicazione web". Vedi LEGGIMI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Fuso orario per gli orari dei lavori automatici e del calendario
SFB_TZ=Europe/Rome

# Lavori automatici: 1 attivi, 0 spenti
SFB_SCHEDULER=1

# ---- Registrazione autonoma delle aziende ----
# aperta = chiunque raggiunga il server può registrare un'azienda; chiusa = le crea solo il gestore
SFB_REGISTRATION=aperta
# Tetto di agenti e limiti per chi si registra da solo: start, business, completo
SFB_REGISTER_PACKAGE=completo
# 0 = chi si registra da solo deve inserire le PROPRIE chiavi dei modelli. 1 = usa le tue (spende il tuo credito)
SFB_REGISTER_PLATFORM_KEYS=0
# Limiti: tentativi all'ora per indirizzo di rete, e aziende nuove all'ora in tutto
SFB_REGISTER_PER_IP_HOUR=5
SFB_REGISTER_PER_HOUR=30
# 1 solo se davanti c'è un TUO proxy che scrive X-Forwarded-For
SFB_TRUST_PROXY=0

# Posta di servizio (facoltativa). Se SFB_SMTP_HOST è compilato, chi si registra deve confermare l'email.
SFB_SMTP_HOST=
SFB_SMTP_PORT=465
SFB_SMTP_USER=
SFB_SMTP_PASSWORD=
SFB_SMTP_FROM_NAME=Alvea

# ---- Archivio dei file ----
# Dimensione massima di un file, in MB
SFB_UPLOAD_MAX_MB=200
# Cartella dei file (vuoto = cartella "storage" accanto al server)
SFB_STORAGE=

# ---- Versione 5: motori locali e lavori ----
# Modello «Locale»: Ollama (o altro servizio compatibile con Chat Completions) accanto al server. Vuoto = solo dal computer del cliente.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1
# Ricerca privata: indirizzo di una tua istanza SearXNG con il formato JSON attivo. Vuoto = Brave.
SEARXNG_URL=
# Montaggio video sui server: 1 attivo (serve FFmpeg sul server), 0 solo sui computer dei clienti
SFB_CLOUD_VIDEO=1
# Lavori sul server: 1 attivi, 0 spenti
SFB_CLOUD_RUNNER=1
# Chiave privata che firma i pacchetti locali. Vuoto = data/firma_privata.pem. In produzione tienila FUORI dal server.
SFB_SIGN_KEY=

# ---- Versione 7: abbonamenti ----
# Giorni di prova gratuita per chi si registra da solo. 0 = nessuna scadenza: decidi tu quando metterla, dalla schermata del gestore.
SFB_TRIAL_DAYS=0

# ---- Versione 8: impostazioni dal pannello e pagamenti ----
# Quasi tutto quello che sta in questo file si può scrivere anche nel pannello del gestore (Impostazioni della piattaforma):
# quello che salvi lì vale più di questo file. Qui restano obbligatori solo indirizzo, porta, SFB_PUBLIC_URL, SFB_SECRET_KEY e SFB_DEMO.
# Stripe (pagamenti con carta): si possono mettere qui oppure nel pannello.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_START=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_COMPLETO=
# Giorni di tolleranza dopo la scadenza dell'abbonamento (0-30). Si può scrivere anche nel pannello.
SFB_GRACE_DAYS=0
# Sito pubblico sulla pagina principale (1) oppure solo l'applicazione (0). L'applicazione sta sempre su /app.
SFB_SITE=1
# Crediti: si impostano dal pannello del gestore (gruppo Crediti). Qui solo l'interruttore, se preferisci il file.
SFB_CREDITS=0

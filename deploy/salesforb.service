# Avvio automatico di SalesForB su un server Linux con systemd.
# Copia in /etc/systemd/system/salesforb.service, poi: systemctl daemon-reload && systemctl enable --now salesforb
[Unit]
Description=SalesForB
After=network-online.target
Wants=network-online.target

[Service]
User=salesforb
WorkingDirectory=/opt/salesforb
ExecStart=/usr/bin/python3 -m server
Restart=on-failure
RestartSec=3
# Il servizio scrive solo in data/ e storage/
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/salesforb/data /opt/salesforb/storage

[Install]
WantedBy=multi-user.target

# HTTPS automatico con Caddy davanti a SalesForB. Sostituisci app.tuodominio.it con il tuo indirizzo
# (il DNS deve già puntare a questo server), copia in /etc/caddy/Caddyfile e riavvia: systemctl reload caddy
app.tuodominio.it {
    encode gzip
    request_body {
        max_size 600MB   # caricamenti di video nell'Archivio Media
    }
    reverse_proxy 127.0.0.1:8787 {
        flush_interval -1
    }
}
